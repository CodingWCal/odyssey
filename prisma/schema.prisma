generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  trips    Trip[]
  members  TripMember[]
  events   Event[]
  expenses Expense[]
  notes    Note[]
  places   Place[]
  paidExpenses  Expense[]      @relation("ExpensePaidBy")
  expenseShares ExpenseShare[]

  availabilitySlots AvailabilitySlot[]
}

model Trip {
  id            String   @id @default(uuid())
  ownerId       String
  title         String
  destination   String
  startDate     DateTime
  endDate       DateTime
  coverImageUrl String?
  totalBudget   Float?
  timeFormat    String   @default("12h") // "12h" | "24h" — display-only preference (ODY-041)
  currency      String   @default("USD") // ISO 4217 code — trip base currency for all money display (ODY-024). Stage 1: symbol/format only, no FX conversion.
  createdAt     DateTime @default(now())

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TripMember[]
  days        Day[]
  expenses    Expense[]
  settlements Settlement[]
  note        Note?

  availabilityPoll  AvailabilityPoll?
  availabilitySlots AvailabilitySlot[]
  places            Place[]
}

/** A recorded settle-up payment outside the expense ledger (ODY-107), e.g.
 * "Sam Venmo'd Alex $30." No User relations — fromUserId/toUserId/createdBy
 * are plain TripMember.userId values; the app already has the member list
 * loaded wherever this is displayed. */
model Settlement {
  id          String   @id @default(uuid())
  tripId      String
  fromUserId  String
  toUserId    String
  amountCents Int
  note        String?
  createdBy   String
  createdAt   DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripMember {
  id          String   @id @default(uuid())
  tripId      String
  userId      String
  role        String   @default("editor")
  splitWeight Float    @default(1)
  joinedAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Day {
  id     String   @id @default(uuid())
  tripId String
  date   DateTime
  label  String?
  notes  String?

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([tripId, date])
}

model Event {
  id         String   @id @default(uuid())
  dayId      String
  tripId     String
  type       String
  title      String
  location   String?
  startTime  String?
  endTime    String?
  notes      String?
  cost         Float?
  orderIndex   Int      @default(0)
  lat          Float?
  lng          Float?
  destLocation String?
  destLat      Float?
  destLng      Float?
  createdBy    String
  createdAt    DateTime @default(now())

  day      Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id])
  expenses Expense[]
}

model Expense {
  id        String   @id @default(uuid())
  tripId    String
  eventId   String?
  label     String
  amount    Float
  category  String
  addedBy   String
  /** Who actually paid (ODY-094) — distinct from addedBy, who logged it.
   * Nullable; reads fall back to addedBy when null, so no backfill needed. */
  paidBy    String?
  /** "equal" | "exact" — cosmetic only, remembers which editor mode to
   * reopen. The authoritative per-person amounts always live in ExpenseShare. */
  splitMode String   @default("equal")
  createdAt DateTime @default(now())

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  event  Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user   User           @relation(fields: [addedBy], references: [id])
  payer  User?          @relation("ExpensePaidBy", fields: [paidBy], references: [id])
  shares ExpenseShare[]
}

/** Who's on the hook for an expense and how much (ODY-094). A row's
 * existence means that person is included; amountCents is always the
 * resolved amount owed (persisted explicitly, even for "equal" splits). */
model ExpenseShare {
  id          String @id @default(uuid())
  expenseId   String
  userId      String
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Note {
  id        String   @id @default(uuid())
  tripId    String   @unique
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])
}

model AvailabilityPoll {
  id                String   @id @default(uuid())
  tripId            String   @unique
  rangeStart        DateTime
  rangeEnd          DateTime
  enabledBlocks     String[]
  desiredLengthDays Int?
  status            String   @default("open")
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  date      DateTime
  block     String
  status    String
  source    String   @default("manual")
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, date, block])
  @@index([tripId])
}

/// Candidate places outside the day-by-day itinerary (ODY-045).
model Place {
  id        String   @id @default(uuid())
  tripId    String
  category  String   // same vocabulary as Event.type for color language
  title     String
  location  String?
  lat       Float?
  lng       Float?
  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@index([tripId])
}
